# SERVER ONLY. Values must match the local Redis and Knowledge development configuration.
APP_ENV=development
NODE_ENV=development
DOCUMENT_PROCESSING_REDIS_HOST=127.0.0.1
DOCUMENT_PROCESSING_REDIS_PORT=16379
DOCUMENT_PROCESSING_REDIS_PASSWORD=replace-with-existing-redis-password
DOCUMENT_PROCESSING_QUEUE_PREFIX=amani:development:knowledge
DOCUMENT_PROCESSING_QUEUE_NAME=document-processing
DOCUMENT_PROCESSING_CONCURRENCY=1
DOCUMENT_PROCESSING_TIMEOUT_MS=120000
KNOWLEDGE_INTERNAL_URL=http://127.0.0.1:4101
KNOWLEDGE_INTERNAL_TIMEOUT_MS=10000
DOCUMENT_PROCESSING_DEVELOPMENT_SECRET=replace-with-distinct-64-hex-worker-to-knowledge-secret
DOCUMENT_PROCESSING_EMBEDDING_PROVIDER=deterministic-test
DOCUMENT_PROCESSING_EMBEDDING_MODEL=deterministic-v1
DOCUMENT_PROCESSING_EMBEDDING_DIMENSION=16
DOCUMENT_PROCESSING_EMBEDDING_CONFIG_VERSION=1
# Required only for openai-compatible. Never use the deterministic provider in production.
# DOCUMENT_PROCESSING_EMBEDDING_BASE_URL=https://api.openai.com/v1
# DOCUMENT_PROCESSING_EMBEDDING_API_KEY=replace-with-server-only-key
DOCUMENT_PROCESSING_EMBEDDING_TIMEOUT_MS=10000
DOCUMENT_PROCESSING_EMBEDDING_BATCH_SIZE=16
DOCUMENT_PROCESSING_MAX_ORIGINAL_BYTES=52428800
DOCUMENT_PROCESSING_MAX_EXTRACTED_CHARACTERS=2000000
DOCUMENT_PROCESSING_MAX_PAGES=500
DOCUMENT_PROCESSING_MAX_PARAGRAPH_CHARACTERS=20000
DOCUMENT_PROCESSING_CHUNK_SIZE=1200
DOCUMENT_PROCESSING_CHUNK_OVERLAP=160
DOCUMENT_PROCESSING_MAX_CHUNKS=2000
