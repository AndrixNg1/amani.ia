# Docker Compose local development only. Copy this file to the root .env.
# Replace these public placeholder passwords before starting dependencies.
# Applications have separate examples; npm does not load this root file.
POSTGRES_DB=amani
POSTGRES_USER=amani
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-local-redis-password
REDIS_PORT=6379

MINIO_ROOT_USER=amani-local-admin
# MinIO requires a password of at least 8 characters.
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
