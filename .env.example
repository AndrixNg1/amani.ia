# LOCAL DEVELOPMENT ONLY. All credentials below are SERVER-SIDE ONLY.
# Copy to the root .env only if absent, or merge new keys into an existing .env.
# Replace every password with a distinct local value. Never use production secrets.
# npm apps do not load this file. Do not export any secret as NEXT_PUBLIC_*.
# Single-quote .env values containing $ or #; do not source this file as shell code.

# Host-side connection hint (not a configurable bind address); port is configurable.
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=amani
# Bootstrap administrator only. Never use POSTGRES_USER/PASSWORD in applications.
POSTGRES_USER=amani
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432

# Fixed schema / SQL login pairs, created on a fresh PostgreSQL volume:
# core_platform / amani_core_platform
CORE_PLATFORM_DB_PASSWORD=replace-with-local-core-platform-password
# knowledge / amani_knowledge
KNOWLEDGE_DB_PASSWORD=replace-with-local-knowledge-password
# data_analytics / amani_data_analytics
DATA_ANALYTICS_DB_PASSWORD=replace-with-local-data-analytics-password
# conversations / amani_conversations
CONVERSATIONS_DB_PASSWORD=replace-with-local-conversations-password
# connectors / amani_connectors
CONNECTORS_DB_PASSWORD=replace-with-local-connectors-password
# evaluation / amani_evaluation
EVALUATION_DB_PASSWORD=replace-with-local-evaluation-password
# No database credentials or schemas for Gateway / AI Orchestrator.

# Redis bootstrap credential for local development; per-service ACLs are future work.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_PORT=6379

# Host-side endpoint hint; update it if MINIO_API_PORT changes.
MINIO_ENDPOINT=http://127.0.0.1:9000
# Administrative access key and secret key only; never give these to a browser.
MINIO_ROOT_USER=amani-local-admin
# MinIO requires a password of at least 8 characters.
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# No buckets are auto-created. Future convention: amani-<service>-<purpose>.
# Future object prefix: organizations/<organizationId>/... (not authorization).
