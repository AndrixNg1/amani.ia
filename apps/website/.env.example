# @amani/website: Next.js development defaults to http://127.0.0.1:3000.
# The port and host are set in package.json; Next.js does not read PORT from .env.
# Override explicitly: npm run dev --workspace=@amani/website -- --port 3100
# No custom environment variable is consumed by the current starter page.
# Reserved for a future server-side gateway client (not implemented):
# GATEWAY_API_URL=http://127.0.0.1:4000
# Never expose service credentials in NEXT_PUBLIC_* variables.
