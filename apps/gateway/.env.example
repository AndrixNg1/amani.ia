# Server only. Copy to apps/gateway/.env; shell values take precedence.
NODE_ENV=development
APP_ENV=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
CORE_API_BASE_URL=http://127.0.0.1:4001
CORE_API_TIMEOUT_MS=3000
CORE_API_MAX_RESPONSE_BYTES=262144
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002
GATEWAY_BODY_LIMIT_BYTES=65536
GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_RATE_IP=120
GATEWAY_RATE_USER=120
GATEWAY_RATE_ORGANIZATION=600
GATEWAY_RATE_MAX_KEYS=10000

# Closed by default. Production user/service authentication is not selected.
GATEWAY_AUTH_MODE=disabled
GATEWAY_SERVICE_AUTH_MODE=disabled
# Optional explicit LOCAL development only; both modes must be development.
# GATEWAY_DEV_BEARER_TOKEN=<generate 32 random bytes as 64 lowercase hex characters>
# GATEWAY_DEV_USER_ID=<existing synthetic Core user UUID; never an arbitrary ID>
# DEVELOPMENT_SERVICE_SECRET=<a DIFFERENT random 64-hex secret, also configured in Core>
# No database, Redis or MinIO credentials belong in Gateway.
