# Copy to .env in this workspace; existing shell variables take precedence.
# Node.js 22.17.0 loads this file when this service starts from its workspace.
HOST=127.0.0.1
PORT=4002

# Local-only service delegation. Production service authentication is not selected.
ORCHESTRATOR_SERVICE_AUTH_MODE=disabled
# NODE_ENV=development
# ORCHESTRATOR_GATEWAY_DEVELOPMENT_SECRET=<same 64-hex secret as Gateway DEVELOPMENT_SERVICE_SECRET>
# ORCHESTRATOR_CORE_DEVELOPMENT_SECRET=<distinct 64-hex secret also configured in Core>
# ORCHESTRATOR_KNOWLEDGE_DEVELOPMENT_SECRET=<distinct 64-hex secret also configured in Knowledge>

CORE_API_URL=http://127.0.0.1:4001
KNOWLEDGE_API_URL=http://127.0.0.1:4101
ORCHESTRATOR_CORE_TIMEOUT_MS=3000
ORCHESTRATOR_KNOWLEDGE_TIMEOUT_MS=5000

# Documentary RAG bounds. Knowledge applies its own stricter bounds and ACLs.
ORCHESTRATOR_RAG_DEFAULT_TOP_K=6
ORCHESTRATOR_RAG_MAX_TOP_K=8
ORCHESTRATOR_RAG_MIN_SIMILARITY_BPS=0
ORCHESTRATOR_RAG_MAX_EVIDENCE_CHUNKS=6
ORCHESTRATOR_RAG_MAX_EVIDENCE_CHARACTERS=12000

# Deterministic generation is permitted only in development/test and has no network access.
ORCHESTRATOR_GENERATION_PROVIDER=deterministic-test
ORCHESTRATOR_GENERATION_MODEL=deterministic-v1
ORCHESTRATOR_GENERATION_TIMEOUT_MS=30000
ORCHESTRATOR_GENERATION_MAX_OUTPUT_TOKENS=700
ORCHESTRATOR_GENERATION_TEMPERATURE_BPS=1000
# Required only for openai-compatible. Server-only: never commit or expose this key.
# ORCHESTRATOR_GENERATION_BASE_URL=https://api.openai.com/v1
# ORCHESTRATOR_GENERATION_API_KEY=replace-with-server-only-key
