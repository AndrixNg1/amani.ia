# SERVER ONLY. env:local copies only the needed values from root .env.
APP_ENV=development
HOST=127.0.0.1
PORT=4001
DB_HOST=127.0.0.1
# Match POSTGRES_PORT in root .env (15432 on the current PC; default Compose: 5432).
DB_PORT=15432
DB_NAME=amani
# Existing CORE_PLATFORM_DB_PASSWORD from root .env; never POSTGRES_PASSWORD.
# Login amani_core_platform and schema core_platform are fixed by application code.
CORE_PLATFORM_DB_PASSWORD=replace-with-existing-core-service-password
DB_SSL=false
DB_POOL_SIZE=10
# Explicit opt-in for integration tests with synthetic fixtures and rollback:
# CORE_DB_TESTS=true
