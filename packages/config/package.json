{
  "name": "@amani/config",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": null,
      "node": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint . --max-warnings=0",
    "lint:check": "eslint . --max-warnings=0",
    "pretest": "npm run build",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "@jest/globals": "30.5.2",
    "jest": "30.5.2",
    "@types/node": "24.19.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.cjs"
    ],
    "collectCoverageFrom": [
      "dist/**/*.js"
    ]
  },
  "engines": {
    "node": ">=22.17.0 <23"
  }
}
