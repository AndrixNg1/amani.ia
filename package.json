{
  "name": "amani-ia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "plugins/*",
    "packages/*"
  ],
  "scripts": {
    "dev:gateway": "npm run start:dev --workspace=@amani/gateway",
    "dev:core": "npm run start:dev --workspace=@amani/core-api",
    "dev:orchestrator": "npm run start:dev --workspace=@amani/ai-orchestrator",
    "dev:enterprise": "npm run dev --workspace=@amani/enterprise",
    "dev:admin": "npm run dev --workspace=@amani/admin",
    "dev:website": "npm run dev --workspace=@amani/website",
    "lint": "npm run lint:check --workspaces",
    "test": "npm run test --workspaces -- --runInBand",
    "build": "npm run build --workspaces",
    "dev": "npm run dev:gateway",
    "typecheck": "npm run typecheck --workspaces",
    "test:backend": "npm run test --workspace=@amani/gateway --workspace=@amani/core-api --workspace=@amani/ai-orchestrator --workspace=@amani/knowledge --workspace=@amani/data-analytics --workspace=@amani/conversations --workspace=@amani/connectors --workspace=@amani/evaluation -- --runInBand",
    "test:e2e": "npm run test:e2e --workspace=@amani/gateway --workspace=@amani/core-api --workspace=@amani/ai-orchestrator --workspace=@amani/knowledge --workspace=@amani/data-analytics --workspace=@amani/conversations --workspace=@amani/connectors --workspace=@amani/evaluation -- --runInBand",
    "check:structure": "node scripts/check-structure.mjs",
    "infra:config": "docker compose --env-file .env.example config --quiet",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "dev:knowledge": "npm run dev --workspace=@amani/knowledge",
    "dev:data-analytics": "npm run dev --workspace=@amani/data-analytics",
    "dev:conversations": "npm run dev --workspace=@amani/conversations",
    "dev:connectors": "npm run dev --workspace=@amani/connectors",
    "dev:evaluation": "npm run dev --workspace=@amani/evaluation"
  },
  "engines": {
    "node": ">=22.17.0 <23",
    "npm": ">=10.9.2 <11"
  }
}
