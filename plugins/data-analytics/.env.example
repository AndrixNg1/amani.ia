# Server only. Copy to plugins/data-analytics/.env; shell values take precedence.
NODE_ENV=development
APP_ENV=development
HOST=127.0.0.1
PORT=4102
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=amani
DB_SSL=false
DATA_ANALYTICS_DB_PASSWORD=<local-data-analytics-schema-password>
DB_POOL_SIZE=10
CORE_API_URL=http://127.0.0.1:4001
CORE_API_TIMEOUT_MS=3000

# Closed by default. Local adapters require loopback development/test only.
DATA_ANALYTICS_SERVICE_AUTH_MODE=disabled
# DATA_ANALYTICS_DEVELOPMENT_SERVICE_SECRET=<Gateway-to-Data-Analytics 64 lowercase hex secret>
# DATA_ANALYTICS_CORE_DEVELOPMENT_SECRET=<Data-Analytics-to-Core different 64 lowercase hex secret>

# Private, versioned S3-compatible bucket. No credentials may be browser-visible.
DATA_ANALYTICS_STORAGE_ENDPOINT=http://127.0.0.1:9000
DATA_ANALYTICS_STORAGE_REGION=us-east-1
DATA_ANALYTICS_STORAGE_BUCKET=amani-data-analytics
DATA_ANALYTICS_STORAGE_ACCESS_KEY=<local-minio-access-key>
DATA_ANALYTICS_STORAGE_SECRET_KEY=<local-minio-secret-key>
DATA_ANALYTICS_STORAGE_FORCE_PATH_STYLE=true
DATA_ANALYTICS_UPLOAD_URL_SECONDS=300
DATA_ANALYTICS_MAX_CSV_BYTES=52428800
DATA_ANALYTICS_MAX_XLSX_BYTES=104857600
DATA_ANALYTICS_ALLOWED_MIME_TYPES=text/csv,application/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
