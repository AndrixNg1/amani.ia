# SERVER ONLY. Replace only with values already present in root .env; never commit secrets.
APP_ENV=development
HOST=127.0.0.1
PORT=4101
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=amani
KNOWLEDGE_DB_PASSWORD=replace-with-existing-knowledge-service-password
DB_SSL=false
DB_POOL_SIZE=10
KNOWLEDGE_SERVICE_AUTH_MODE=disabled
# NODE_ENV=development
# KNOWLEDGE_DEVELOPMENT_SERVICE_SECRET=<same local 64-hex secret as future Gateway->Knowledge>
# KNOWLEDGE_CORE_DEVELOPMENT_SECRET=<distinct local 64-hex secret also configured in Core>
# KNOWLEDGE_DOCUMENT_PROCESSING_DEVELOPMENT_SECRET=<distinct local 64-hex secret shared only with the worker>
# KNOWLEDGE_ORCHESTRATOR_DEVELOPMENT_SECRET=<distinct local 64-hex secret shared only with AI Orchestrator>
CORE_API_URL=http://127.0.0.1:4001
CORE_API_TIMEOUT_MS=3000
KNOWLEDGE_STORAGE_ENDPOINT=http://127.0.0.1:9000
KNOWLEDGE_STORAGE_REGION=us-east-1
KNOWLEDGE_STORAGE_BUCKET=amani-knowledge-originals
KNOWLEDGE_STORAGE_ACCESS_KEY=replace-with-existing-minio-service-access-key
KNOWLEDGE_STORAGE_SECRET_KEY=replace-with-existing-minio-service-secret-key
KNOWLEDGE_STORAGE_FORCE_PATH_STYLE=true
KNOWLEDGE_UPLOAD_URL_SECONDS=300
KNOWLEDGE_DOWNLOAD_URL_SECONDS=120
KNOWLEDGE_MAX_UPLOAD_BYTES=52428800
KNOWLEDGE_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown
KNOWLEDGE_PROCESSING_REDIS_HOST=127.0.0.1
KNOWLEDGE_PROCESSING_REDIS_PORT=16379
KNOWLEDGE_PROCESSING_REDIS_PASSWORD=replace-with-existing-redis-password
KNOWLEDGE_PROCESSING_QUEUE_PREFIX=amani:development:knowledge
KNOWLEDGE_RETRIEVAL_MAX_QUERY_CHARACTERS=2000
KNOWLEDGE_RETRIEVAL_DEFAULT_TOP_K=6
KNOWLEDGE_RETRIEVAL_MAX_TOP_K=20
KNOWLEDGE_RETRIEVAL_MIN_SIMILARITY_BPS=0
# This profile must exactly match READY chunks. Deterministic is local/test only.
KNOWLEDGE_RETRIEVAL_EMBEDDING_PROVIDER=deterministic-test
KNOWLEDGE_RETRIEVAL_EMBEDDING_MODEL=deterministic-v1
KNOWLEDGE_RETRIEVAL_EMBEDDING_DIMENSION=16
KNOWLEDGE_RETRIEVAL_EMBEDDING_CONFIG_VERSION=1
KNOWLEDGE_RETRIEVAL_EMBEDDING_TIMEOUT_MS=10000
# Required only for openai-compatible. Never expose this key to browsers.
# KNOWLEDGE_RETRIEVAL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# KNOWLEDGE_RETRIEVAL_EMBEDDING_API_KEY=replace-with-server-only-key
